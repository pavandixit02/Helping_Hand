// Enterprise Schema for Helping Hand (10/10 Architecture)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector] // pgvector for AI Matchings
}

// ==========================================
// 1. RBAC (Dynamic Roles & Permissions)
// ==========================================

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique // e.g., 'CUSTOMER', 'PARTNER', 'OPERATOR', 'ADMIN'
  description String?
  permissions RolePermission[]
  users       User[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique // e.g., 'appointment:read', 'wallet:write'
  description String?
  roles       RolePermission[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ==========================================
// 2. Authentication & Core User Identity
// ==========================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  BANNED
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique
  passwordHash    String
  roleId          String         @db.Uuid
  role            Role           @relation(fields: [roleId], references: [id])
  isEmailVerified Boolean        @default(false)
  mfaEnabled      Boolean        @default(false)
  mfaSecret       String?
  status          UserStatus     @default(PENDING)

  sessions        UserSession[]
  refreshTokens   RefreshToken[]
  otps            OTP[]
  devices         Device[]
  loginHistory    LoginHistory[]
  
  customerProfile CustomerProfile?
  partnerProfile  PartnerProfile?
  operatorProfile OperatorProfile?

  wallet          Wallet?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model OTP {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String   // e.g., 'EMAIL_VERIFICATION', 'PASSWORD_RESET', 'MFA'
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Device {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String   @unique
  deviceType   String   // 'IOS', 'ANDROID', 'WEB'
  fcmPushToken String?
  lastActive   DateTime @default(now())
  isTrusted    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())
}

// ==========================================
// 3. User Profiles & Healthcare Core
// ==========================================

model CustomerProfile {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @unique @db.Uuid
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  phone            String?
  address          Json?             @db.JsonB
  emergencyContact Json?             @db.JsonB
  appointments     Appointment[]
  insurance        Insurance?
  medicalDocs      MedicalDocument[]
  consent          Consent[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model OperatorProfile {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       String
  level            Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model PartnerProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  specialty          String
  licenseNumber      String             // Encrypted
  verificationStatus VerificationStatus @default(PENDING)
  bio                String?            @db.Text
  averageRating      Float              @default(0)
  totalReviews       Int                @default(0)
  location           Json?              @db.JsonB // PostGIS candidate
  
  services           Service[]
  appointments       Appointment[]
  workingHours       WorkingHours[]
  blockedSlots       BlockedSlots[]
  leaves             Leaves[]
  recurringSchedule  RecurringSchedule[]
  partnerKyc         PartnerKYC?

  // pgvector extension field mapping (1536 dims for OpenAI embeddings)
  embedding          Unsupported("vector(1536)")? 
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// Healthcare compliance tables
model PartnerKYC {
  id             String         @id @default(uuid()) @db.Uuid
  partnerId      String         @unique @db.Uuid
  partner        PartnerProfile @relation(fields: [partnerId], references: [id])
  documentType   String
  documentUrl    String         // S3 URI
  verifiedBy     String?        @db.Uuid // Operator ID
  verifiedAt     DateTime?
  status         VerificationStatus
  createdAt      DateTime       @default(now())
}

model MedicalDocument {
  id          String          @id @default(uuid()) @db.Uuid
  customerId  String          @db.Uuid
  customer    CustomerProfile @relation(fields: [customerId], references: [id])
  title       String
  fileUrl     String          // Encrypted S3 URI
  docType     String          // e.g., 'PRESCRIPTION', 'LAB_REPORT'
  uploadedAt  DateTime        @default(now())
}

model Consent {
  id          String          @id @default(uuid()) @db.Uuid
  customerId  String          @db.Uuid
  customer    CustomerProfile @relation(fields: [customerId], references: [id])
  type        String          // e.g., 'DATA_PROCESSING', 'TELEHEALTH'
  isGranted   Boolean
  ipAddress   String?
  timestamp   DateTime        @default(now())
}

model Insurance {
  id          String          @id @default(uuid()) @db.Uuid
  customerId  String          @unique @db.Uuid
  customer    CustomerProfile @relation(fields: [customerId], references: [id])
  provider    String
  policyNo    String          // Encrypted
  verified    Boolean         @default(false)
}

// ==========================================
// 4. Partner Management (Availability & Scheduling)
// ==========================================

model WorkingHours {
  id         String         @id @default(uuid()) @db.Uuid
  partnerId  String         @db.Uuid
  partner    PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  dayOfWeek  Int            // 0=Sun, 1=Mon...
  startTime  String         // "09:00"
  endTime    String         // "17:00"
}

model BlockedSlots {
  id         String         @id @default(uuid()) @db.Uuid
  partnerId  String         @db.Uuid
  partner    PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  startTime  DateTime
  endTime    DateTime
  reason     String?
}

model Leaves {
  id         String         @id @default(uuid()) @db.Uuid
  partnerId  String         @db.Uuid
  partner    PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime
  status     String         // 'APPROVED', 'PENDING'
}

model RecurringSchedule {
  id         String         @id @default(uuid()) @db.Uuid
  partnerId  String         @db.Uuid
  partner    PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  cronString String
  config     Json           @db.JsonB
}

// ==========================================
// 5. Booking & Appointments
// ==========================================

model Service {
  id              String         @id @default(uuid()) @db.Uuid
  partnerId       String         @db.Uuid
  partner         PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name            String
  description     String         @db.Text
  price           Decimal        @db.Decimal(10, 2)
  durationMinutes Int
  isActive        Boolean        @default(true)
  appointments    Appointment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  customerId  String            @db.Uuid
  customer    CustomerProfile   @relation(fields: [customerId], references: [id])
  partnerId   String            @db.Uuid
  partner     PartnerProfile    @relation(fields: [partnerId], references: [id])
  serviceId   String            @db.Uuid
  service     Service           @relation(fields: [serviceId], references: [id])
  scheduledAt DateTime
  status      AppointmentStatus @default(PENDING)
  meetingLink String?
  notes       String?           @db.Text // Encrypted

  payment     Payment?
  review      Review?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([scheduledAt])
  @@index([partnerId, scheduledAt])
  @@index([partnerId, status, scheduledAt])
}

// ==========================================
// 6. Wallet & Financial System
// ==========================================

enum TransactionType {
  CREDIT
  DEBIT
}

enum ReferenceType {
  APPOINTMENT
  REFUND
  CASHBACK
  WITHDRAWAL
}

enum TransactionStatus {
  SUCCESS
  PENDING
  FAILED
}

enum SettlementStatus {
  PENDING
  PROCESSED
}

enum PayoutStatus {
  INITIATED
  COMPLETED
  FAILED
}

enum RefundStatus {
  INITIATED
  COMPLETED
  FAILED
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @unique @db.Uuid
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  currency     String              @default("INR")
  transactions WalletTransaction[]
  ledgers      WalletLedger[]
  updatedAt    DateTime            @updatedAt
}

model WalletTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  walletId      String   @db.Uuid
  wallet        Wallet   @relation(fields: [walletId], references: [id])
  amount        Decimal  @db.Decimal(12, 2)
  type          TransactionType
  referenceType ReferenceType
  referenceId   String?  @db.Uuid
  status        TransactionStatus
  createdAt     DateTime @default(now())

  @@index([walletId, status, createdAt])
}

model WalletLedger {
  id            String   @id @default(uuid()) @db.Uuid
  walletId      String   @db.Uuid
  wallet        Wallet   @relation(fields: [walletId], references: [id])
  balanceBefore Decimal  @db.Decimal(12, 2)
  balanceAfter  Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  appointmentId     String        @unique @db.Uuid
  appointment       Appointment   @relation(fields: [appointmentId], references: [id])
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  gatewayOrderId    String        @unique // e.g. Razorpay order id
  gatewayPaymentId  String?
  
  commission        Commission?
  settlement        Settlement?
  refund            Refund?
  invoice           Invoice?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Commission {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String   @unique @db.Uuid
  payment         Payment  @relation(fields: [paymentId], references: [id])
  platformRevenue Decimal  @db.Decimal(10, 2) // What platform keeps
  partnerAmount   Decimal  @db.Decimal(10, 2) // What partner gets
  createdAt       DateTime @default(now())
}

model Settlement {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String   @unique @db.Uuid
  payment         Payment  @relation(fields: [paymentId], references: [id])
  partnerPayoutId String   @db.Uuid
  partnerPayout   PartnerPayout @relation(fields: [partnerPayoutId], references: [id])
  status          SettlementStatus
  createdAt       DateTime @default(now())
}

model PartnerPayout {
  id          String       @id @default(uuid()) @db.Uuid
  partnerId   String       @db.Uuid
  amount      Decimal      @db.Decimal(12, 2)
  status      PayoutStatus
  bankTxnRef  String?
  settlements Settlement[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Refund {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @unique @db.Uuid
  payment     Payment  @relation(fields: [paymentId], references: [id])
  amount      Decimal  @db.Decimal(10, 2)
  reason      String
  status      RefundStatus
  createdAt   DateTime @default(now())
}

model Invoice {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @unique @db.Uuid
  payment     Payment  @relation(fields: [paymentId], references: [id])
  invoiceUrl  String   // S3 URI
  generatedAt DateTime @default(now())
}

model Cashback {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  amount      Decimal  @db.Decimal(10, 2)
  reason      String
  status      String   // 'APPLIED'
  createdAt   DateTime @default(now())
}

model PlatformRevenue {
  id          String   @id @default(uuid()) @db.Uuid
  sourceType  String   // 'COMMISSION', 'SUBSCRIPTION'
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
}

// ==========================================
// 7. Communications (Chat & Notifications)
// ==========================================

model Conversation {
  id          String     @id @default(uuid()) @db.Uuid
  participantIds String[] // Array of user UUIDs
  messages    Message[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String       @db.Uuid
  content        String       @db.Text // Encrypted
  isRead         Boolean      @default(false)
  attachments    Attachment[]
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Attachment {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id])
  fileUrl   String   // S3 URI
  mimeType  String
  createdAt DateTime @default(now())
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  provider  String   // 'FCM', 'APNS'
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  body      String
  type      String   // 'BOOKING', 'REMINDER', 'PAYMENT', 'EMERGENCY'
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NotificationPreference {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @db.Uuid
  emailEnabled Boolean @default(true)
  pushEnabled  Boolean @default(true)
  smsEnabled   Boolean @default(false)
}

model Review {
  id            String      @id @default(uuid()) @db.Uuid
  appointmentId String      @unique @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  rating        Int         
  comment       String?     @db.Text
  isApproved    Boolean     @default(false) 
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ==========================================
// 8. AI Platform Core
// ==========================================

model PromptLog {
  id          String   @id @default(uuid()) @db.Uuid
  promptId    String   // Reference to version-controlled prompt registry
  userId      String?  @db.Uuid
  model       String   // e.g. 'gpt-4o'
  promptText  String   @db.Text // PII scrubbed
  response    String   @db.Text
  latencyMs   Int
  tokensUsed  Int
  cost        Decimal? @db.Decimal(10, 5)
  timestamp   DateTime @default(now())
}

model AIMatch {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @db.Uuid
  matchedPartnerId String @db.Uuid
  confidenceScore Float
  factors        Json           @db.JsonB // Why they matched
  wasSuccessful  Boolean? // Feedback loop
  createdAt      DateTime @default(now())
}

model AIRecommendation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  recommendation String   @db.Text
  confidenceScore Float
  actionTaken    Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model EmbeddingMetadata {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   // 'PARTNER', 'CLINICAL_GUIDELINE'
  entityId   String   @db.Uuid
  modelUsed  String   // e.g. 'text-embedding-3-small'
  updatedAt  DateTime @default(now())
}

// ==========================================
// 9. Analytics & Audit
// ==========================================

model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  eventType  String   // e.g., 'PAGE_VIEW', 'BOOKING_INITIATED'
  screenName String?
  metadata   Json?             @db.JsonB
  timestamp  DateTime @default(now())
}

model UserActivity {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String
  timestamp  DateTime @default(now())
}

model SearchHistory {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  query      String
  filters    Json?             @db.JsonB
  resultsFound Int
  timestamp  DateTime @default(now())
}

// ==========================================
// 10. CMS Platform
// ==========================================

model Article {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  slug      String   @unique
  content   String   @db.Text
  authorId  String   @db.Uuid
  status    String   @default("DRAFT") // 'DRAFT', 'PUBLISHED'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(uuid()) @db.Uuid
  category  String
  question  String
  answer    String   @db.Text
  isActive  Boolean  @default(true)
  order     Int      @default(0)
}

// ==========================================
// 11. CRM Platform
// ==========================================

model SupportTicket {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  subject     String
  description String   @db.Text
  status      String   @default("OPEN") // 'OPEN', 'IN_PROGRESS', 'RESOLVED'
  priority    String   @default("MEDIUM")
  operatorId  String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomerNote {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  authorId    String   @db.Uuid
  note        String   @db.Text
  createdAt   DateTime @default(now())
}

// ==========================================
// 12. Audit & Configuration
// ==========================================

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  action      String
  resource    String
  resourceId  String?
  details     Json?    @db.JsonB
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json     @db.JsonB
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?  @db.Uuid
}

// ==========================================
// 13. Workflow Engine
// ==========================================

model ApprovalWorkflow {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   // 'REFUND', 'KYC'
  referenceId String   @db.Uuid
  status      String   @default("PENDING") // 'PENDING', 'APPROVED', 'REJECTED'
  step        Int      @default(1)
  config      Json?    @db.JsonB
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
